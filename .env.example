# ---------------------------------------------------------------------------
# ARISE environment configuration
#
# Copy this file to `.env` and fill in the values.
# Only VITE_-prefixed variables are exposed to the browser bundle.
#
# IMPORTANT: only the Supabase URL and the anon/publishable key belong here.
# Never put the service_role key, database passwords, or any privileged
# credential in a VITE_ variable — it would be shipped to every visitor.
# ---------------------------------------------------------------------------

# Supabase project URL (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon (publishable) key — safe for client code, protected by RLS
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key

# Optional: public origin used for auth redirects in production
# (e.g. https://arise.vercel.app). Leave empty for local development.
VITE_APP_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Local development fallback
# ---------------------------------------------------------------------------
# When VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY are missing, ARISE runs in
# "Local mode": data is persisted in this browser via localStorage and accounts
# are stored locally with salted PBKDF2 password hashes. Local mode exists so
# the app is fully usable and testable without cloud credentials. Production
# deployments must be configured with Supabase.
